# Blank means same-origin: the frontend already appends /api/...
PUBLIC_API_URL=
CORS_ALLOWED_ORIGINS=https://rubennmg.cloud,https://www.rubennmg.cloud
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ENABLE_DEMO_DATA=false
AUTH_SECRET_KEY=change-me
AUTH_COOKIE_NAME=rubennmg_staging_session
AUTH_SESSION_DAYS=7
# Use a URL-safe value, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=change-me
