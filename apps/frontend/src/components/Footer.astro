---
const { content } = Astro.props;
const year = new Date().getFullYear();
const month = new Date().toLocaleString(
    content.locale === "es" ? "es-ES" : "en-GB",
    { month: "long" },
);
---

<footer class="shell py-10 sm:py-14">
    <div
        class="flex flex-col gap-5 border-t border-border pt-7 text-sm text-textsoft sm:flex-row sm:items-center sm:justify-between"
    >
        <p>© {year} {content.profile.name}</p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <span>{content.labels.madeWith}</span><span
                >{content.labels.updated} {month} {year}</span>
        </div>
    </div>
</footer>
