---
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/person.svg" />
        <title>Admin Jugadores | rubennmg</title>
    </head>
    <body class="min-h-screen bg-[#080910] text-[#f8f3ea]">
        <main
            class="relative min-h-screen overflow-hidden px-4 py-8 sm:px-8 lg:px-12"
        >
            <div
                class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_15%_10%,rgba(241,170,78,0.15),transparent_28%),radial-gradient(circle_at_85%_20%,rgba(168,178,209,0.12),transparent_24%),linear-gradient(135deg,#080910_0%,#14141d_55%,#0b0d12_100%)]"
            >
            </div>

            <section class="mx-auto max-w-7xl">
                <nav
                    class="mb-10 flex items-center justify-between gap-4 text-sm text-[#cacaca]"
                >
                    <a href="/admin" class="transition hover:text-white"
                        >← Admin</a
                    >
                    <button
                        id="logout-button"
                        type="button"
                        class="hidden rounded-full border border-white/15 bg-white/5 px-4 py-2 font-semibold text-[#f6f1e8] transition hover:bg-white/10"
                    >
                        Cerrar sesión
                    </button>
                </nav>

                <section
                    id="loading-state"
                    class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-8 text-[#c9c3b7]"
                >
                    Cargando jugadores...
                </section>

                <section id="players-content" class="hidden">
                    <header
                        class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end"
                    >
                        <div>
                            <p
                                class="mb-4 text-sm font-bold uppercase tracking-[0.35em] text-[#f1aa4e]"
                            >
                                Administración
                            </p>
                            <h1
                                class="text-4xl font-black tracking-tight text-white sm:text-6xl"
                            >
                                Jugadores
                            </h1>
                            <p
                                class="mt-5 max-w-2xl text-lg leading-8 text-[#c9c3b7]"
                            >
                                Gestiona los jugadores que podrán aparecer en
                                partidas y rankings.
                            </p>
                        </div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <article
                                class="rounded-3xl border border-white/10 bg-white/[0.05] p-6"
                            >
                                <p
                                    class="text-sm uppercase tracking-[0.25em] text-[#a8b2d1]"
                                >
                                    Total
                                </p>
                                <p
                                    id="total-players"
                                    class="mt-3 text-4xl font-black text-white"
                                >
                                    0
                                </p>
                            </article>
                            <article
                                class="rounded-3xl border border-white/10 bg-white/[0.05] p-6"
                            >
                                <p
                                    class="text-sm uppercase tracking-[0.25em] text-[#a8b2d1]"
                                >
                                    Activos
                                </p>
                                <p
                                    id="active-players"
                                    class="mt-3 text-4xl font-black text-white"
                                >
                                    0
                                </p>
                            </article>
                        </div>
                    </header>

                    <div class="mt-12 grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
                        <section
                            class="rounded-[2rem] border border-white/10 bg-white/[0.05] p-6"
                        >
                            <h2
                                id="form-title"
                                class="text-2xl font-black text-white"
                            >
                                Nuevo jugador
                            </h2>
                            <p class="mt-2 text-sm leading-6 text-[#c9c3b7]">
                                El nombre visible es obligatorio. Nickname y
                                avatar son opcionales.
                            </p>

                            <form id="player-form" class="mt-6 space-y-5">
                                <input
                                    id="player-id"
                                    name="player-id"
                                    type="hidden"
                                />

                                <div>
                                    <label
                                        for="display-name"
                                        class="block text-sm font-semibold text-[#f8f3ea]"
                                    >
                                        Nombre visible
                                    </label>
                                    <input
                                        id="display-name"
                                        name="display-name"
                                        type="text"
                                        maxlength="150"
                                        required
                                        class="mt-2 w-full rounded-2xl border border-white/10 bg-black/25 px-4 py-3 text-white outline-none transition placeholder:text-[#777] focus:border-[#f1aa4e]/70 focus:ring-4 focus:ring-[#f1aa4e]/10"
                                        placeholder="Rubén"
                                    />
                                </div>

                                <div>
                                    <label
                                        for="nickname"
                                        class="block text-sm font-semibold text-[#f8f3ea]"
                                    >
                                        Nickname
                                    </label>
                                    <input
                                        id="nickname"
                                        name="nickname"
                                        type="text"
                                        maxlength="150"
                                        class="mt-2 w-full rounded-2xl border border-white/10 bg-black/25 px-4 py-3 text-white outline-none transition placeholder:text-[#777] focus:border-[#f1aa4e]/70 focus:ring-4 focus:ring-[#f1aa4e]/10"
                                        placeholder="Opcional"
                                    />
                                </div>

                                <div>
                                    <label
                                        for="avatar-url"
                                        class="block text-sm font-semibold text-[#f8f3ea]"
                                    >
                                        Avatar URL
                                    </label>
                                    <input
                                        id="avatar-url"
                                        name="avatar-url"
                                        type="url"
                                        class="mt-2 w-full rounded-2xl border border-white/10 bg-black/25 px-4 py-3 text-white outline-none transition placeholder:text-[#777] focus:border-[#f1aa4e]/70 focus:ring-4 focus:ring-[#f1aa4e]/10"
                                        placeholder="https://..."
                                    />
                                </div>

                                <p
                                    id="form-message"
                                    class="hidden rounded-2xl border p-4 text-sm"
                                    role="alert"
                                >
                                </p>

                                <div class="flex flex-wrap gap-3">
                                    <button
                                        id="save-button"
                                        type="submit"
                                        class="rounded-full border border-[#f1aa4e]/70 bg-[#f1aa4e] px-6 py-3 text-sm font-black text-[#151008] shadow-lg shadow-[#f1aa4e]/20 transition hover:-translate-y-0.5 hover:bg-[#ffd18a] disabled:cursor-not-allowed disabled:opacity-60"
                                    >
                                        Guardar
                                    </button>
                                    <button
                                        id="cancel-edit-button"
                                        type="button"
                                        class="hidden rounded-full border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-[#f6f1e8] transition hover:bg-white/10"
                                    >
                                        Cancelar edición
                                    </button>
                                </div>
                            </form>
                        </section>

                        <section
                            class="overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04]"
                        >
                            <div
                                class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 p-6"
                            >
                                <div>
                                    <h2 class="text-2xl font-black text-white">
                                        Listado
                                    </h2>
                                    <p
                                        id="list-message"
                                        class="mt-2 text-sm text-[#c9c3b7]"
                                    >
                                        Jugadores ordenados por nombre.
                                    </p>
                                </div>
                                <button
                                    id="refresh-button"
                                    type="button"
                                    class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-[#f6f1e8] transition hover:bg-white/10"
                                >
                                    Recargar
                                </button>
                            </div>
                            <div class="overflow-x-auto">
                                <table
                                    class="min-w-full divide-y divide-white/10 text-left text-sm"
                                >
                                    <thead
                                        class="bg-white/[0.04] text-xs uppercase tracking-[0.18em] text-[#a8b2d1]"
                                    >
                                        <tr>
                                            <th class="px-5 py-4">Jugador</th>
                                            <th class="px-5 py-4">Nickname</th>
                                            <th class="px-5 py-4">Estado</th>
                                            <th class="px-5 py-4">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody
                                        id="players-table"
                                        class="divide-y divide-white/10 text-[#f8f3ea]"
                                    ></tbody>
                                </table>
                            </div>
                        </section>
                    </div>
                </section>

                <section
                    id="error-state"
                    class="mt-12 hidden rounded-[2rem] border border-red-400/30 bg-red-500/10 p-8 text-red-100"
                >
                    No se pudo cargar la administración de jugadores.
                </section>
            </section>
        </main>

        <script is:inline define:vars={{ apiUrl }}>
            const loadingState = document.getElementById("loading-state");
            const playersContent = document.getElementById("players-content");
            const errorState = document.getElementById("error-state");
            const logoutButton = document.getElementById("logout-button");
            const table = document.getElementById("players-table");
            const totalPlayers = document.getElementById("total-players");
            const activePlayers = document.getElementById("active-players");
            const listMessage = document.getElementById("list-message");
            const refreshButton = document.getElementById("refresh-button");
            const form = document.getElementById("player-form");
            const formTitle = document.getElementById("form-title");
            const playerIdInput = document.getElementById("player-id");
            const displayNameInput = document.getElementById("display-name");
            const nicknameInput = document.getElementById("nickname");
            const avatarUrlInput = document.getElementById("avatar-url");
            const formMessage = document.getElementById("form-message");
            const saveButton = document.getElementById("save-button");
            const cancelEditButton =
                document.getElementById("cancel-edit-button");

            let players = [];
            let csrfToken = "";

            const show = (element) => element?.classList.remove("hidden");
            const hide = (element) => element?.classList.add("hidden");
            const textOrDash = (value) => value || "-";

            const request = (path, options = {}) =>
                fetch(`${apiUrl}${path}`, {
                    ...options,
                    credentials: "include",
                    headers: {
                        Accept: "application/json",
                        ...(options.body
                            ? { "Content-Type": "application/json" }
                            : {}),
                        ...(csrfToken &&
                        options.method &&
                        options.method !== "GET"
                            ? { "X-CSRF-Token": csrfToken }
                            : {}),
                        ...(options.headers ?? {}),
                    },
                });

            const setFormMessage = (message, type) => {
                formMessage.textContent = message;
                formMessage.className =
                    type === "success"
                        ? "rounded-2xl border border-emerald-400/30 bg-emerald-500/10 p-4 text-sm text-emerald-100"
                        : "rounded-2xl border border-red-400/30 bg-red-500/10 p-4 text-sm text-red-100";
            };

            const clearFormMessage = () => {
                formMessage.textContent = "";
                formMessage.className = "hidden rounded-2xl border p-4 text-sm";
            };

            const resetForm = () => {
                form.reset();
                playerIdInput.value = "";
                formTitle.textContent = "Nuevo jugador";
                saveButton.textContent = "Guardar";
                hide(cancelEditButton);
                clearFormMessage();
            };

            const startEdit = (player) => {
                playerIdInput.value = player.id;
                displayNameInput.value = player.display_name;
                nicknameInput.value = player.nickname ?? "";
                avatarUrlInput.value = player.avatar_url ?? "";
                formTitle.textContent = "Editar jugador";
                saveButton.textContent = "Actualizar";
                show(cancelEditButton);
                clearFormMessage();
                displayNameInput.focus();
            };

            const renderPlayers = () => {
                table.replaceChildren();
                totalPlayers.textContent = String(players.length);
                activePlayers.textContent = String(
                    players.filter((player) => player.is_active).length,
                );

                if (!players.length) {
                    listMessage.textContent =
                        "Todavía no hay jugadores registrados.";
                    return;
                }

                listMessage.textContent = "Jugadores ordenados por nombre.";

                for (const player of players) {
                    const row = document.createElement("tr");
                    row.className = "transition hover:bg-white/[0.04]";

                    const nameCell = document.createElement("td");
                    nameCell.className = "px-5 py-4 font-semibold text-white";
                    nameCell.textContent = player.display_name;

                    const nicknameCell = document.createElement("td");
                    nicknameCell.className = "px-5 py-4 text-[#c9c3b7]";
                    nicknameCell.textContent = textOrDash(player.nickname);

                    const statusCell = document.createElement("td");
                    statusCell.className = "px-5 py-4";
                    const statusBadge = document.createElement("span");
                    statusBadge.className = player.is_active
                        ? "rounded-full border border-emerald-400/30 bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-100"
                        : "rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-bold text-[#c9c3b7]";
                    statusBadge.textContent = player.is_active
                        ? "Activo"
                        : "Inactivo";
                    statusCell.append(statusBadge);

                    const actionsCell = document.createElement("td");
                    actionsCell.className = "flex flex-wrap gap-2 px-5 py-4";

                    const editButton = document.createElement("button");
                    editButton.type = "button";
                    editButton.className =
                        "rounded-full border border-white/15 bg-white/5 px-3 py-2 text-xs font-semibold text-[#f6f1e8] transition hover:bg-white/10";
                    editButton.textContent = "Editar";
                    editButton.addEventListener("click", () =>
                        startEdit(player),
                    );

                    const statusButton = document.createElement("button");
                    statusButton.type = "button";
                    statusButton.className =
                        "rounded-full border border-[#f1aa4e]/30 bg-[#f1aa4e]/10 px-3 py-2 text-xs font-semibold text-[#ffd18a] transition hover:bg-[#f1aa4e]/20";
                    statusButton.textContent = player.is_active
                        ? "Desactivar"
                        : "Activar";
                    statusButton.addEventListener("click", () =>
                        updateStatus(player, !player.is_active),
                    );

                    actionsCell.append(editButton, statusButton);
                    row.append(nameCell, nicknameCell, statusCell, actionsCell);
                    table.append(row);
                }
            };

            async function ensureSessionAndCsrf() {
                const sessionResponse = await request("/api/auth/me");
                if (sessionResponse.status === 401) {
                    window.location.replace("/admin/login");
                    return false;
                }
                if (!sessionResponse.ok)
                    throw new Error("Session request failed");

                const csrfResponse = await request("/api/auth/csrf");
                if (!csrfResponse.ok) throw new Error("CSRF request failed");
                const csrfData = await csrfResponse.json();
                csrfToken = csrfData.csrf_token;
                return true;
            }

            async function loadPlayers() {
                const response = await request("/api/admin/players");
                if (response.status === 401) {
                    window.location.replace("/admin/login");
                    return;
                }
                if (!response.ok) throw new Error("Players request failed");

                players = await response.json();
                renderPlayers();
            }

            async function updateStatus(player, isActive) {
                clearFormMessage();
                const response = await request(
                    `/api/admin/players/${player.id}/status`,
                    {
                        method: "PATCH",
                        body: JSON.stringify({ is_active: isActive }),
                    },
                );

                if (!response.ok) {
                    setFormMessage(
                        "No se pudo cambiar el estado del jugador.",
                        "error",
                    );
                    return;
                }

                await loadPlayers();
            }

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                clearFormMessage();
                saveButton.disabled = true;

                const playerId = playerIdInput.value;
                const payload = {
                    display_name: displayNameInput.value.trim(),
                    nickname: nicknameInput.value.trim() || null,
                    avatar_url: avatarUrlInput.value.trim() || null,
                };

                try {
                    const response = await request(
                        playerId
                            ? `/api/admin/players/${playerId}`
                            : "/api/admin/players",
                        {
                            method: playerId ? "PUT" : "POST",
                            body: JSON.stringify(payload),
                        },
                    );

                    if (response.status === 409) {
                        setFormMessage(
                            "Ya existe un jugador con ese nombre.",
                            "error",
                        );
                        return;
                    }

                    if (!response.ok) {
                        setFormMessage(
                            "No se pudo guardar el jugador.",
                            "error",
                        );
                        return;
                    }

                    resetForm();
                    setFormMessage(
                        "Jugador guardado correctamente.",
                        "success",
                    );
                    await loadPlayers();
                } catch (error) {
                    setFormMessage("No se pudo conectar con la API.", "error");
                } finally {
                    saveButton.disabled = false;
                }
            });

            refreshButton.addEventListener("click", loadPlayers);
            cancelEditButton.addEventListener("click", resetForm);

            logoutButton.addEventListener("click", async () => {
                logoutButton.disabled = true;
                logoutButton.textContent = "Saliendo...";

                try {
                    await request("/api/auth/logout", { method: "POST" });
                } finally {
                    window.location.assign("/admin/login");
                }
            });

            async function boot() {
                try {
                    const hasSession = await ensureSessionAndCsrf();
                    if (!hasSession) return;
                    await loadPlayers();
                    hide(loadingState);
                    show(playersContent);
                    show(logoutButton);
                } catch (error) {
                    hide(loadingState);
                    show(errorState);
                }
            }

            boot();
        </script>
    </body>
</html>
