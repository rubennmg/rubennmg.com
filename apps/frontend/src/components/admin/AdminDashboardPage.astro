---
import GamesLayout from "../games/GamesLayout.astro";
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000";
---

<GamesLayout title="Admin | rubennmg">
        <main id="game-content" class="games-main shell">

            <section class="mx-auto max-w-6xl">
                <nav
                    class="mb-10 flex items-center justify-between gap-4 text-sm text-textsoft"
                >
                    <a href="/" class="transition hover:text-df-text"
                        >← Portfolio</a
                    >
                    <button
                        id="logout-button"
                        type="button"
                        class="hidden rounded-full border border-border bg-background px-4 py-2 font-semibold text-df-text transition hover:bg-background"
                    >
                        Cerrar sesión
                    </button>
                </nav>

                <section
                    id="loading-state"
                    class="rounded-3xl border border-border bg-background p-8 text-textsoft"
                >
                    Comprobando sesión...
                </section>

                <section id="admin-content" class="hidden">
                    <header
                        class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr] lg:items-end"
                    >
                        <div>
                            <p
                                class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-accent"
                            >
                                Panel privado
                            </p>
                            <h1
                                class="text-4xl font-extrabold tracking-tight text-df-text sm:text-6xl"
                            >
                                Administración
                            </h1>
                            <p
                                class="mt-5 max-w-2xl text-lg leading-8 text-textsoft"
                            >
                                Sesión iniciada como <span
                                    id="admin-username"
                                    class="font-bold text-df-text"></span>.
                                Gestiona jugadores y registra los resultados de
                                tus partidas para actualizar los rankings.
                            </p>
                        </div>
                        <div
                            class="soft-card p-6"
                        >
                            <p
                                class="text-sm uppercase tracking-[0.2em] text-textsoft"
                            >
                                Estado
                            </p>
                            <p class="mt-3 text-2xl font-bold text-df-text">
                                Autenticado
                            </p>
                            <p class="mt-2 text-sm text-textsoft">
                                Tu sesión está activa.
                            </p>
                        </div>
                    </header>

                    <div class="mt-12 grid gap-4 md:grid-cols-2">
                        <a
                            href="/admin/players"
                            class="soft-card p-6"
                        >
                            <p
                                class="text-sm uppercase tracking-[0.2em] text-textsoft"
                            >
                                Jugadores
                            </p>
                            <h2 class="mt-3 text-2xl font-extrabold text-df-text">
                                Gestionar jugadores
                            </h2>
                            <p class="mt-3 text-sm leading-6 text-textsoft">
                                Añade jugadores, edita sus datos y gestiona
                                quién puede participar en nuevas partidas.
                            </p>
                        </a>
                        <a
                            href="/admin/matches"
                            class="soft-card p-6"
                        >
                            <p
                                class="text-sm uppercase tracking-[0.2em] text-textsoft"
                            >
                                Partidas
                            </p>
                            <h2 class="mt-3 text-2xl font-extrabold text-df-text">
                                Gestionar partidas
                            </h2>
                            <p class="mt-3 text-sm leading-6 text-textsoft">
                                Registra, corrige o elimina partidas. Sus
                                resultados se reflejan en los rankings.
                            </p>
                        </a>
                    </div>
                </section>

                <section
                    id="error-state"
                    class="mt-12 hidden rounded-3xl border border-[var(--feedback-error)]/30 bg-[var(--feedback-error)]/10 p-8 text-[var(--feedback-error)]"
                >
                    No se pudo comprobar la sesión. Vuelve a iniciar sesión.
                </section>
            </section>
        </main>

        <script is:inline define:vars={{ apiUrl }}>
            const loadingState = document.getElementById("loading-state");
            const adminContent = document.getElementById("admin-content");
            const errorState = document.getElementById("error-state");
            const adminUsername = document.getElementById("admin-username");
            const logoutButton = document.getElementById("logout-button");

            const show = (element) => element?.classList.remove("hidden");
            const hide = (element) => element?.classList.add("hidden");

            async function loadSession() {
                try {
                    const response = await fetch(`${apiUrl}/api/auth/me`, {
                        headers: { Accept: "application/json" },
                        credentials: "include",
                    });

                    if (response.status === 401) {
                        window.location.replace("/admin/login");
                        return;
                    }

                    if (!response.ok) throw new Error("Session request failed");

                    const data = await response.json();
                    adminUsername.textContent = data.user.username;
                    hide(loadingState);
                    show(adminContent);
                    show(logoutButton);
                } catch (error) {
                    hide(loadingState);
                    show(errorState);
                }
            }

            logoutButton.addEventListener("click", async () => {
                logoutButton.disabled = true;
                logoutButton.textContent = "Saliendo...";

                try {
                    await fetch(`${apiUrl}/api/auth/logout`, {
                        method: "POST",
                        credentials: "include",
                    });
                } finally {
                    window.location.assign("/admin/login");
                }
            });

            loadSession();
        </script>
</GamesLayout>
