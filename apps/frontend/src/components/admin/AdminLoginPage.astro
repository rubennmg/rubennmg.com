---
import GamesLayout from "../games/GamesLayout.astro";
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000";
---

<GamesLayout title="Admin Login | rubennmg">
        <main id="game-content" class="games-main shell games-login">

            <section class="w-full max-w-md">
                <a
                    href="/"
                    class="mb-8 inline-flex text-sm font-semibold text-textsoft transition hover:text-df-text"
                >
                    ← Volver al portfolio
                </a>

                <div
                    class="soft-card p-8"
                >
                    <p
                        class="text-sm font-bold uppercase tracking-[0.2em] text-accent"
                    >
                        Administración
                    </p>
                    <h1
                        class="mt-4 text-4xl font-extrabold tracking-tight text-df-text"
                    >
                        Iniciar sesión
                    </h1>
                    <p class="mt-3 text-sm leading-6 text-textsoft">
                        Acceso privado para gestionar jugadores y partidas.
                    </p>

                    <div
                        id="session-check"
                        class="mt-6 rounded-2xl border border-border bg-background p-4 text-sm text-textsoft"
                    >
                        Comprobando sesión...
                    </div>

                    <form id="login-form" class="mt-6 space-y-5">
                        <div>
                            <label
                                for="username"
                                class="block text-sm font-semibold text-df-text"
                            >
                                Usuario
                            </label>
                            <input
                                id="username"
                                name="username"
                                type="text"
                                autocomplete="username"
                                required
                                class="mt-2 w-full rounded-2xl border border-border bg-bodyback px-4 py-3 text-df-text outline-none transition placeholder:text-textsoft focus:border-accent focus:ring-4 focus:ring-accent/20"
                                placeholder="admin"
                            />
                        </div>

                        <div>
                            <label
                                for="password"
                                class="block text-sm font-semibold text-df-text"
                            >
                                Contraseña
                            </label>
                            <input
                                id="password"
                                name="password"
                                type="password"
                                autocomplete="current-password"
                                required
                                class="mt-2 w-full rounded-2xl border border-border bg-bodyback px-4 py-3 text-df-text outline-none transition placeholder:text-textsoft focus:border-accent focus:ring-4 focus:ring-accent/20"
                                placeholder="••••••••"
                            />
                        </div>

                        <p
                            id="login-error"
                            class="hidden rounded-2xl border border-[var(--feedback-error)]/30 bg-[var(--feedback-error)]/10 p-4 text-sm text-[var(--feedback-error)]"
                            role="alert"
                        >
                            No se pudo iniciar sesión.
                        </p>

                        <button
                            id="login-button"
                            type="submit"
                            class="primary-button w-full disabled:cursor-not-allowed disabled:opacity-60"
                        >
                            Entrar
                        </button>
                    </form>
                </div>
            </section>
        </main>

        <script is:inline define:vars={{ apiUrl }}>
            const form = document.getElementById("login-form");
            const errorMessage = document.getElementById("login-error");
            const loginButton = document.getElementById("login-button");
            const sessionCheck = document.getElementById("session-check");

            const showError = (message) => {
                errorMessage.textContent = message;
                errorMessage.classList.remove("hidden");
            };

            async function checkSession() {
                try {
                    const response = await fetch(`${apiUrl}/api/auth/me`, {
                        headers: { Accept: "application/json" },
                        credentials: "include",
                    });

                    if (response.ok) {
                        window.location.assign("/admin");
                        return;
                    }
                } catch (error) {
                    sessionCheck.textContent =
                        "No se pudo comprobar la sesión. Puedes intentar iniciar sesión igualmente.";
                    return;
                }

                sessionCheck.classList.add("hidden");
            }

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                errorMessage.classList.add("hidden");
                loginButton.disabled = true;
                loginButton.textContent = "Entrando...";

                const formData = new FormData(form);

                try {
                    const response = await fetch(`${apiUrl}/api/auth/login`, {
                        method: "POST",
                        headers: {
                            Accept: "application/json",
                            "Content-Type": "application/json",
                        },
                        credentials: "include",
                        body: JSON.stringify({
                            username: String(formData.get("username") ?? ""),
                            password: String(formData.get("password") ?? ""),
                        }),
                    });

                    if (response.ok) {
                        window.location.assign("/admin");
                        return;
                    }

                    if (response.status === 401) {
                        showError("Usuario o contraseña incorrectos.");
                        return;
                    }

                    if (response.status === 429) {
                        showError(
                            "Demasiados intentos fallidos. Espera unos minutos antes de probar de nuevo.",
                        );
                        return;
                    }

                    showError("No se pudo iniciar sesión. Inténtalo de nuevo.");
                } catch (error) {
                    showError("No se pudo conectar con la API local/remota.");
                } finally {
                    loginButton.disabled = false;
                    loginButton.textContent = "Entrar";
                }
            });

            checkSession();
        </script>
</GamesLayout>
