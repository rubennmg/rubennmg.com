---
import GamesLayout from "../games/GamesLayout.astro";
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000";
---

<GamesLayout title="Admin Partidas | rubennmg">
        <main id="game-content" class="games-main shell">

            <section class="mx-auto max-w-7xl">
                <nav
                    class="mb-10 flex items-center justify-between gap-4 text-sm text-textsoft"
                >
                    <a href="/admin" class="transition hover:text-df-text"
                        >← Admin</a
                    >
                    <button
                        id="logout-button"
                        type="button"
                        class="hidden rounded-full border border-border bg-background px-4 py-2 font-semibold text-df-text transition hover:bg-background"
                    >
                        Cerrar sesión
                    </button>
                </nav>

                <section
                    id="loading-state"
                    class="rounded-3xl border border-border bg-background p-8 text-textsoft"
                >
                    Cargando partidas...
                </section>

                <section id="matches-content" class="hidden">
                    <header
                        class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end"
                    >
                        <div>
                            <p
                                class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-accent"
                            >
                                Administración
                            </p>
                            <h1
                                class="text-4xl font-extrabold tracking-tight text-df-text sm:text-6xl"
                            >
                                Partidas
                            </h1>
                            <p
                                class="mt-5 max-w-2xl text-lg leading-8 text-textsoft"
                            >
                                Registra resultados completos para alimentar
                                rankings automáticamente.
                            </p>
                        </div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <article
                                class="rounded-3xl border border-border bg-background p-6"
                            >
                                <p
                                    class="text-sm uppercase tracking-[0.2em] text-textsoft"
                                >
                                    Partidas
                                </p>
                                <p
                                    id="total-matches"
                                    class="mt-3 text-4xl font-extrabold text-df-text"
                                >
                                    0
                                </p>
                            </article>
                            <article
                                class="rounded-3xl border border-border bg-background p-6"
                            >
                                <p
                                    class="text-sm uppercase tracking-[0.2em] text-textsoft"
                                >
                                    Jugadores activos
                                </p>
                                <p
                                    id="active-players"
                                    class="mt-3 text-4xl font-extrabold text-df-text"
                                >
                                    0
                                </p>
                            </article>
                        </div>
                    </header>

                    <div class="mt-12 grid gap-8 xl:grid-cols-[0.95fr_1.05fr]">
                        <section
                            class="rounded-3xl border border-border bg-background p-6"
                        >
                            <h2
                                id="form-title"
                                class="text-2xl font-extrabold text-df-text"
                            >
                                Nueva partida
                            </h2>
                            <p class="mt-2 text-sm leading-6 text-textsoft">
                                Debe haber un único ganador. Catán requiere
                                posición para todos los jugadores.
                            </p>

                            <form id="match-form" class="mt-6 space-y-5">
                                <input id="match-id" type="hidden" />

                                <div class="grid gap-4 sm:grid-cols-2">
                                    <div>
                                        <label
                                            for="game-slug"
                                            class="block text-sm font-semibold text-df-text"
                                            >Juego</label
                                        >
                                        <select
                                            id="game-slug"
                                            required
                                            class="mt-2 w-full rounded-2xl border border-border bg-bodyback px-4 py-3 text-df-text outline-none transition focus:border-accent focus:ring-4 focus:ring-accent/20"
                                        >
                                        </select>
                                    </div>
                                    <div>
                                        <label
                                            for="played-at"
                                            class="block text-sm font-semibold text-df-text"
                                            >Fecha</label
                                        >
                                        <input
                                            id="played-at"
                                            type="datetime-local"
                                            required
                                            class="mt-2 w-full rounded-2xl border border-border bg-bodyback px-4 py-3 text-df-text outline-none transition focus:border-accent focus:ring-4 focus:ring-accent/20"
                                        />
                                    </div>
                                </div>

                                <div>
                                    <label
                                        for="notes"
                                        class="block text-sm font-semibold text-df-text"
                                        >Notas</label
                                    >
                                    <textarea
                                        id="notes"
                                        rows="3"
                                        class="mt-2 w-full rounded-2xl border border-border bg-bodyback px-4 py-3 text-df-text outline-none transition placeholder:text-textsoft focus:border-accent focus:ring-4 focus:ring-accent/20"
                                        placeholder="Opcional"></textarea>
                                </div>

                                <div
                                    class="rounded-3xl border border-border bg-bodyback p-4"
                                >
                                    <div
                                        class="flex flex-wrap items-center justify-between gap-3"
                                    >
                                        <h3 class="font-extrabold text-df-text">
                                            Resultados
                                        </h3>
                                        <button
                                            id="add-result-button"
                                            type="button"
                                            class="rounded-full border border-border bg-background px-4 py-2 text-xs font-semibold text-df-text transition hover:bg-background"
                                        >
                                            Añadir jugador
                                        </button>
                                    </div>
                                    <div
                                        id="results-list"
                                        class="mt-4 space-y-3"
                                    >
                                    </div>
                                </div>

                                <p
                                    id="form-message"
                                    class="hidden rounded-2xl border p-4 text-sm"
                                    role="alert"
                                >
                                </p>

                                <div class="flex flex-wrap gap-3">
                                    <button
                                        id="save-button"
                                        type="submit"
                                        class="primary-button disabled:cursor-not-allowed disabled:opacity-60"
                                    >
                                        Guardar
                                    </button>
                                    <button
                                        id="cancel-edit-button"
                                        type="button"
                                        class="hidden rounded-full border border-border bg-background px-6 py-3 text-sm font-semibold text-df-text transition hover:bg-background"
                                    >
                                        Cancelar edición
                                    </button>
                                </div>
                            </form>
                        </section>

                        <section
                            class="overflow-hidden rounded-3xl border border-border bg-background"
                        >
                            <div
                                class="flex flex-wrap items-center justify-between gap-4 border-b border-border p-6"
                            >
                                <div>
                                    <h2 class="text-2xl font-extrabold text-df-text">
                                        Listado
                                    </h2>
                                    <p
                                        id="list-message"
                                        class="mt-2 text-sm text-textsoft"
                                    >
                                        Partidas más recientes primero.
                                    </p>
                                </div>
                                <div class="flex flex-wrap gap-3">
                                    <select
                                        id="game-filter"
                                        class="rounded-full border border-border bg-bodyback px-4 py-2 text-sm font-semibold text-df-text outline-none"
                                    >
                                    </select>
                                    <button
                                        id="refresh-button"
                                        type="button"
                                        class="rounded-full border border-border bg-background px-4 py-2 text-sm font-semibold text-df-text transition hover:bg-background"
                                    >
                                        Recargar
                                    </button>
                                </div>
                            </div>
                            <div
                                id="matches-list"
                                class="divide-y divide-border"
                            >
                            </div>
                        </section>
                    </div>
                </section>

                <section
                    id="error-state"
                    class="mt-12 hidden rounded-3xl border border-[var(--feedback-error)]/30 bg-[var(--feedback-error)]/10 p-8 text-[var(--feedback-error)]"
                >
                    No se pudo cargar la administración de partidas.
                </section>
            </section>
        </main>

        <script is:inline define:vars={{ apiUrl }}>
            const loadingState = document.getElementById("loading-state");
            const matchesContent = document.getElementById("matches-content");
            const errorState = document.getElementById("error-state");
            const logoutButton = document.getElementById("logout-button");
            const totalMatches = document.getElementById("total-matches");
            const activePlayersCount =
                document.getElementById("active-players");
            const gameFilter = document.getElementById("game-filter");
            const gameSlugInput = document.getElementById("game-slug");
            const playedAtInput = document.getElementById("played-at");
            const notesInput = document.getElementById("notes");
            const matchIdInput = document.getElementById("match-id");
            const resultsList = document.getElementById("results-list");
            const matchesList = document.getElementById("matches-list");
            const listMessage = document.getElementById("list-message");
            const form = document.getElementById("match-form");
            const formTitle = document.getElementById("form-title");
            const formMessage = document.getElementById("form-message");
            const saveButton = document.getElementById("save-button");
            const cancelEditButton =
                document.getElementById("cancel-edit-button");
            const addResultButton =
                document.getElementById("add-result-button");
            const refreshButton = document.getElementById("refresh-button");

            let csrfToken = "";
            let games = [];
            let players = [];
            let matches = [];
            let existingPlayerIds = new Set();

            const show = (element) => element?.classList.remove("hidden");
            const hide = (element) => element?.classList.add("hidden");
            const textOrDash = (value) => value || "-";

            const request = (path, options = {}) =>
                fetch(`${apiUrl}${path}`, {
                    ...options,
                    credentials: "include",
                    headers: {
                        Accept: "application/json",
                        ...(options.body
                            ? { "Content-Type": "application/json" }
                            : {}),
                        ...(csrfToken &&
                        options.method &&
                        options.method !== "GET"
                            ? { "X-CSRF-Token": csrfToken }
                            : {}),
                        ...(options.headers ?? {}),
                    },
                });

            const formatDate = (value) =>
                new Intl.DateTimeFormat("es-ES", {
                    dateStyle: "medium",
                    timeStyle: "short",
                }).format(new Date(value));

            const toDateTimeLocal = (value) => {
                const date = value ? new Date(value) : new Date();
                const offsetDate = new Date(
                    date.getTime() - date.getTimezoneOffset() * 60000,
                );
                return offsetDate.toISOString().slice(0, 16);
            };

            const setFormMessage = (message, type) => {
                formMessage.textContent = message;
                formMessage.className =
                    type === "success"
                        ? "rounded-2xl border border-[var(--feedback-success)]/30 bg-[var(--feedback-success)]/10 p-4 text-sm text-[var(--feedback-success)]"
                        : "rounded-2xl border border-[var(--feedback-error)]/30 bg-[var(--feedback-error)]/10 p-4 text-sm text-[var(--feedback-error)]";
            };

            const clearFormMessage = () => {
                formMessage.textContent = "";
                formMessage.className = "hidden rounded-2xl border p-4 text-sm";
            };

            const option = (value, label) => {
                const element = document.createElement("option");
                element.value = value;
                element.textContent = label;
                return element;
            };

            const renderSelects = () => {
                gameSlugInput.replaceChildren(
                    ...games.map((game) =>
                        option(game.slug, game.display_name),
                    ),
                );
                gameFilter.replaceChildren(
                    option("", "Todos los juegos"),
                    ...games.map((game) =>
                        option(game.slug, game.display_name),
                    ),
                );
            };

            const resultRow = (result = {}) => {
                const row = document.createElement("div");
                row.className =
                    "grid gap-3 rounded-2xl border border-border bg-background p-3 md:grid-cols-[1.3fr_0.7fr_0.7fr_0.5fr_auto]";

                const playerSelect = document.createElement("select");
                playerSelect.className =
                    "rounded-xl border border-border bg-bodyback px-3 py-2 text-sm text-df-text outline-none";
                playerSelect.required = true;
                playerSelect.setAttribute("aria-label", "Jugador");
                playerSelect.append(
                    option("", "Jugador"),
                    ...players
                        .filter((player) => player.is_active || existingPlayerIds.has(player.id))
                        .map((player) => option(
                            player.id,
                            `${player.display_name}${player.is_active ? "" : " (inactivo · histórico)"}`,
                        )),
                );
                playerSelect.value =
                    result.player_id ?? result.player?.id ?? "";

                const scoreInput = document.createElement("input");
                scoreInput.type = "number";
                scoreInput.min = "0";
                scoreInput.required = true;
                scoreInput.placeholder = "Puntos";
                scoreInput.setAttribute("aria-label", "Puntos");
                scoreInput.className =
                    "rounded-xl border border-border bg-bodyback px-3 py-2 text-sm text-df-text outline-none placeholder:text-textsoft";
                scoreInput.value = result.score ?? "";

                const positionInput = document.createElement("input");
                positionInput.type = "number";
                positionInput.min = "1";
                positionInput.placeholder = "Pos.";
                positionInput.setAttribute("aria-label", "Posición");
                positionInput.className =
                    "rounded-xl border border-border bg-bodyback px-3 py-2 text-sm text-df-text outline-none placeholder:text-textsoft";
                positionInput.value = result.position ?? "";

                const winnerLabel = document.createElement("label");
                winnerLabel.className =
                    "flex items-center gap-2 rounded-xl border border-border bg-bodyback px-3 py-2 text-sm text-df-text";
                const winnerInput = document.createElement("input");
                winnerInput.type = "radio";
                winnerInput.name = "winner";
                winnerInput.checked = Boolean(result.is_winner);
                winnerLabel.append(winnerInput, "Gana");

                const removeButton = document.createElement("button");
                removeButton.type = "button";
                removeButton.className =
                    "rounded-xl border border-[var(--feedback-error)]/30 bg-[var(--feedback-error)]/10 px-3 py-2 text-sm font-semibold text-[var(--feedback-error)]";
                removeButton.textContent = "Quitar";
                removeButton.addEventListener("click", () => row.remove());

                row.append(
                    playerSelect,
                    scoreInput,
                    positionInput,
                    winnerLabel,
                    removeButton,
                );
                const catanFields = document.createElement("fieldset");
                catanFields.dataset.catan = "";
                catanFields.className = "col-span-full grid gap-3 border-t border-border pt-3 sm:grid-cols-2";
                const legend = document.createElement("legend");
                legend.className = "text-sm font-bold text-accent";
                legend.textContent = "Detalles de Catán";
                catanFields.append(legend);
                for (const [key, label] of [
                    ["cities", "Número de ciudades"],
                    ["settlements", "Número de pueblos"],
                    ["roads", "Número de carreteras"],
                    ["victory_point_cards", "Puntos de victoria (cartas)"],
                ]) {
                    const fieldLabel = document.createElement("label");
                    fieldLabel.className = "grid gap-1 text-sm text-textsoft";
                    fieldLabel.append(label);
                    const input = document.createElement("input");
                    input.type = "number";
                    input.min = "0";
                    input.step = "1";
                    input.required = true;
                    input.dataset.catanField = key;
                    input.value = result.catan?.[key] ?? 0;
                    input.className = "min-w-0 w-full rounded-xl border border-border bg-bodyback px-3 py-2 text-df-text";
                    fieldLabel.append(input);
                    catanFields.append(fieldLabel);
                }
                for (const [key, label] of [
                    ["longest_road", "Carretera más larga"],
                    ["largest_army", "Mayor ejército"],
                ]) {
                    const fieldLabel = document.createElement("label");
                    fieldLabel.className = "flex items-center gap-2 text-sm text-df-text";
                    const input = document.createElement("input");
                    input.type = "checkbox";
                    input.dataset.catanField = key;
                    input.checked = result.catan?.[key] ?? false;
                    fieldLabel.append(input, label);
                    catanFields.append(fieldLabel);
                }
                row.append(catanFields);
                catanFields.hidden = gameSlugInput.value !== "catan";
                catanFields.disabled = gameSlugInput.value !== "catan";
                return row;
            };

            const addResultRow = (result) => {
                resultsList.append(resultRow(result));
            };

            const resetForm = () => {
                form.reset();
                matchIdInput.value = "";
                existingPlayerIds = new Set();
                playedAtInput.value = toDateTimeLocal();
                resultsList.replaceChildren();
                const game = games.find((candidate) => candidate.slug === gameSlugInput.value);
                for (let index = 0; index < (game?.min_players ?? 2); index++) {
                    addResultRow();
                }
                formTitle.textContent = "Nueva partida";
                saveButton.textContent = "Guardar";
                hide(cancelEditButton);
                clearFormMessage();
            };

            const renderMatches = () => {
                matchesList.replaceChildren();
                totalMatches.textContent = String(matches.length);

                if (!matches.length) {
                    listMessage.textContent =
                        "Todavía no hay partidas registradas.";
                    return;
                }

                listMessage.textContent = "Partidas más recientes primero.";

                for (const match of matches) {
                    const article = document.createElement("article");
                    article.className = "p-6 transition hover:bg-background";

                    const header = document.createElement("div");
                    header.className =
                        "flex flex-wrap items-start justify-between gap-4";

                    const summary = document.createElement("div");
                    const title = document.createElement("h3");
                    title.className = "text-xl font-extrabold text-df-text";
                    title.textContent = `${match.game.display_name} · ${formatDate(match.played_at)}`;
                    const winner = match.results.find(
                        (result) => result.is_winner,
                    );
                    const meta = document.createElement("p");
                    meta.className = "mt-2 text-sm text-textsoft";
                    meta.textContent = `Ganador: ${winner?.player.display_name ?? "-"} · ${match.results.length} jugadores`;
                    summary.append(title, meta);

                    const actions = document.createElement("div");
                    actions.className = "flex flex-wrap gap-2";
                    const editButton = document.createElement("button");
                    editButton.type = "button";
                    editButton.className =
                        "rounded-full border border-border bg-background px-3 py-2 text-xs font-semibold text-df-text transition hover:bg-background";
                    editButton.textContent = "Editar";
                    editButton.addEventListener("click", () =>
                        startEdit(match),
                    );
                    const deleteButton = document.createElement("button");
                    deleteButton.type = "button";
                    deleteButton.className =
                        "rounded-full border border-[var(--feedback-error)]/30 bg-[var(--feedback-error)]/10 px-3 py-2 text-xs font-semibold text-[var(--feedback-error)] transition hover:bg-[var(--feedback-error)]/20";
                    deleteButton.textContent = "Borrar";
                    deleteButton.addEventListener("click", () =>
                        deleteMatch(match),
                    );
                    actions.append(editButton, deleteButton);

                    header.append(summary, actions);

                    const results = document.createElement("p");
                    results.className = "mt-4 text-sm leading-6 text-textsoft";
                    results.textContent = match.results
                        .map((result) => {
                            const position = result.position
                                ? `#${result.position} · `
                                : "";
                            const winnerLabel = result.is_winner
                                ? " · ganador"
                                : "";
                            const details = result.catan;
                            const catanSummary = details
                                ? ` · ${details.cities ?? "—"} ciudades, ${details.settlements ?? "—"} pueblos, ${details.roads ?? "—"} carreteras, ${details.victory_point_cards ?? "—"} PV en cartas${details.longest_road ? " · carretera más larga" : ""}${details.largest_army ? " · mayor ejército" : ""}`
                                : "";
                            return `${position}${result.player.display_name}: ${result.score} pts${winnerLabel}${catanSummary}`;
                        })
                        .join(" | ");

                    const notes = document.createElement("p");
                    notes.className = "mt-3 text-sm text-textsoft";
                    notes.textContent = textOrDash(match.notes);

                    article.append(header, results, notes);
                    matchesList.append(article);
                }
            };

            const startEdit = (match) => {
                matchIdInput.value = match.id;
                existingPlayerIds = new Set(match.results.map((result) => result.player.id));
                gameSlugInput.value = match.game.slug;
                playedAtInput.value = toDateTimeLocal(match.played_at);
                notesInput.value = match.notes ?? "";
                resultsList.replaceChildren();
                for (const result of match.results) addResultRow(result);
                formTitle.textContent = "Editar partida";
                saveButton.textContent = "Actualizar";
                show(cancelEditButton);
                clearFormMessage();
                form.scrollIntoView({ behavior: "smooth", block: "start" });
            };

            const collectResults = () =>
                [...resultsList.children]
                    .map((row) => {
                        const [playerSelect, scoreInput, positionInput] =
                            row.querySelectorAll("select,input[type='number']");
                        const winnerInput = row.querySelector(
                            "input[type='radio']",
                        );
                        return {
                            player_id: playerSelect.value,
                            score: Number(scoreInput.value),
                            position: positionInput.value
                                ? Number(positionInput.value)
                                : null,
                            is_winner: winnerInput.checked,
                            catan: gameSlugInput.value === "catan"
                                ? Object.fromEntries([...row.querySelectorAll("[data-catan-field]")].map((input) => [
                                    input.dataset.catanField,
                                    input.type === "checkbox" ? input.checked : Number(input.value),
                                ]))
                                : null,
                        };
                    })
                    .filter((result) => result.player_id);

            const validateMatchPayload = (payload) => {
                const game = games.find(
                    (candidate) => candidate.slug === payload.game_slug,
                );
                if (!game) return "Selecciona un juego válido.";

                if (payload.results.length < game.min_players) {
                    return `${game.display_name} requiere al menos ${game.min_players} jugadores.`;
                }

                const playerIds = payload.results.map(
                    (result) => result.player_id,
                );
                if (new Set(playerIds).size !== playerIds.length) {
                    return "No puedes repetir jugadores en la misma partida.";
                }

                const winners = payload.results.filter(
                    (result) => result.is_winner,
                );
                if (winners.length !== 1) {
                    return "Marca exactamente un ganador.";
                }

                const hasInvalidScore = payload.results.some(
                    (result) =>
                        !Number.isFinite(result.score) || result.score < 0,
                );
                if (hasInvalidScore) {
                    return "Todos los puntos deben ser números iguales o superiores a 0.";
                }

                const hasInvalidPosition = payload.results.some(
                    (result) =>
                        result.position !== null &&
                        (!Number.isFinite(result.position) ||
                            result.position < 1),
                );
                if (hasInvalidPosition) {
                    return "Las posiciones deben ser números superiores a 0.";
                }

                if (
                    game.ranking_strategy === "catan_default" &&
                    payload.results.some((result) => result.position === null)
                ) {
                    return "Catán requiere posición para todos los jugadores.";
                }

                return null;
            };

            async function ensureSessionAndCsrf() {
                const sessionResponse = await request("/api/auth/me");
                if (sessionResponse.status === 401) {
                    window.location.replace("/admin/login");
                    return false;
                }
                if (!sessionResponse.ok)
                    throw new Error("Session request failed");

                const csrfResponse = await request("/api/auth/csrf");
                if (!csrfResponse.ok) throw new Error("CSRF request failed");
                const csrfData = await csrfResponse.json();
                csrfToken = csrfData.csrf_token;
                return true;
            }

            async function loadBaseData() {
                const [gamesResponse, playersResponse] = await Promise.all([
                    request("/api/games"),
                    request("/api/admin/players"),
                ]);
                if (!gamesResponse.ok || !playersResponse.ok) {
                    throw new Error("Base data request failed");
                }
                games = await gamesResponse.json();
                players = await playersResponse.json();
                activePlayersCount.textContent = String(players.filter((player) => player.is_active).length);
                renderSelects();
            }

            async function loadMatches() {
                const query = gameFilter.value
                    ? `?game=${encodeURIComponent(gameFilter.value)}`
                    : "";
                const response = await request(`/api/admin/matches${query}`);
                if (response.status === 401) {
                    window.location.replace("/admin/login");
                    return;
                }
                if (!response.ok) throw new Error("Matches request failed");
                matches = await response.json();
                renderMatches();
            }

            async function deleteMatch(match) {
                if (!window.confirm("¿Borrar esta partida?")) return;
                try {
                    const response = await request(
                        `/api/admin/matches/${match.id}`,
                        { method: "DELETE" },
                    );
                    if (!response.ok) {
                        setFormMessage("No se pudo borrar la partida.", "error");
                        return;
                    }
                    if (matchIdInput.value === match.id) resetForm();
                    await loadMatches();
                } catch (error) {
                    setFormMessage("No se pudo conectar con la API. Recarga el listado para comprobar si la partida se borró.", "error");
                }
            }

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                clearFormMessage();
                saveButton.disabled = true;

                const matchId = matchIdInput.value;
                const payload = {
                    game_slug: gameSlugInput.value,
                    played_at: new Date(playedAtInput.value).toISOString(),
                    notes: notesInput.value.trim() || null,
                    results: collectResults(),
                };

                const validationError = validateMatchPayload(payload);
                if (validationError) {
                    setFormMessage(validationError, "error");
                    saveButton.disabled = false;
                    return;
                }

                try {
                    const response = await request(
                        matchId
                            ? `/api/admin/matches/${matchId}`
                            : "/api/admin/matches",
                        {
                            method: matchId ? "PUT" : "POST",
                            body: JSON.stringify(payload),
                        },
                    );

                    if (response.status === 422) {
                        const data = await response.json();
                        const messages = {
                            "Players cannot be repeated": "No puedes repetir jugadores en la misma partida.",
                            "Exactly one winner is required": "Marca exactamente un ganador.",
                            "Catán matches require positions for every player": "Indica la posición de todos los jugadores de Catán.",
                            "Players must exist; inactive players can only remain in their existing matches": "Solo puedes conservar jugadores inactivos que ya participaban en esta partida. Recarga la página para actualizar los jugadores disponibles.",
                        };
                        setFormMessage(
                            (Object.hasOwn(messages, data.detail) ? messages[data.detail] : null)
                                ?? "Revisa el número de jugadores, el ganador, los puntos y las posiciones. Catán requiere al menos tres jugadores y posición para todos.",
                            "error",
                        );
                        return;
                    }

                    if (response.status === 401 || response.status === 403) {
                        setFormMessage("Tu sesión ha caducado o no permite guardar cambios. Vuelve a iniciar sesión.", "error");
                        return;
                    }

                    if (!response.ok) {
                        setFormMessage(
                            "No se pudo guardar la partida.",
                            "error",
                        );
                        return;
                    }

                    resetForm();
                    setFormMessage(
                        "Partida guardada correctamente.",
                        "success",
                    );
                    await loadMatches();
                } catch (error) {
                    setFormMessage("No se pudo conectar con la API.", "error");
                } finally {
                    saveButton.disabled = false;
                }
            });

            addResultButton.addEventListener("click", () => addResultRow());
            gameSlugInput.addEventListener("change", () => {
                for (const fields of resultsList.querySelectorAll("[data-catan]")) {
                    fields.hidden = gameSlugInput.value !== "catan";
                    fields.disabled = gameSlugInput.value !== "catan";
                }
            });
            cancelEditButton.addEventListener("click", resetForm);
            refreshButton.addEventListener("click", loadMatches);
            gameFilter.addEventListener("change", loadMatches);

            logoutButton.addEventListener("click", async () => {
                logoutButton.disabled = true;
                logoutButton.textContent = "Saliendo...";
                try {
                    await request("/api/auth/logout", { method: "POST" });
                } finally {
                    window.location.assign("/admin/login");
                }
            });

            async function boot() {
                try {
                    const hasSession = await ensureSessionAndCsrf();
                    if (!hasSession) return;
                    await loadBaseData();
                    resetForm();
                    await loadMatches();
                    hide(loadingState);
                    show(matchesContent);
                    show(logoutButton);
                } catch (error) {
                    hide(loadingState);
                    show(errorState);
                }
            }

            boot();
        </script>
</GamesLayout>
