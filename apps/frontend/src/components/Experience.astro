---
import ExperienceItem from "./ExperienceItem.astro";
const { items, currentLabel } = Astro.props;
---

<ol class="divide-y divide-border border-y border-border">
    {
        items.map((item) => (
            <li>
                <ExperienceItem {...item} currentLabel={currentLabel} />
            </li>
        ))
    }
</ol>
