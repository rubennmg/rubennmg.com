        place: "Futuver",
        date: "abr. 2025 - actualidad",
        description: "Jornada completa",
        link: "https://futuver.com/",
        logo: "futu_logo.jpg",
    },
    {
        title: "Desarrollador de software",
        place: "Futuver",
        date: "oct. 2025 - mar. 2025",
        description: "Contrato de prácticas",
        link: "https://futuver.com/",
        logo: "futu_logo.jpg",
    },
