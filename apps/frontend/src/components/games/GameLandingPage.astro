---
interface Props {
    gameName: string;
    gameSlug: string;
    eyebrow: string;
    description: string;
    accent: string;
}

const { gameName, gameSlug, eyebrow, description, accent } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/person.svg" />
        <title>{gameName} | Rankings</title>
    </head>
    <body class="min-h-screen bg-[#090a0f] text-[#f6f1e8]">
        <main class="relative isolate overflow-hidden">
            <div
                class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(241,170,78,0.20),transparent_34%),radial-gradient(circle_at_bottom_right,rgba(138,123,158,0.18),transparent_30%)]"
            >
            </div>
            <section
                class="mx-auto flex min-h-screen w-full max-w-6xl flex-col justify-center px-6 py-16 sm:px-10"
            >
                <p
                    class="mb-4 text-sm font-semibold uppercase tracking-[0.35em] text-[#f1aa4e]"
                >
                    {eyebrow}
                </p>
                <div class="max-w-3xl">
                    <h1
                        class="text-5xl font-black tracking-tight text-white sm:text-7xl"
                    >
                        {gameName}
                    </h1>
                    <p class="mt-6 text-lg leading-8 text-[#c9c3b7] sm:text-xl">
                        {description}
                    </p>
                </div>
                <div class="mt-10 flex flex-wrap gap-4">
                    <a
                        href={`/games/${gameSlug}/rankings`}
                        class="rounded-full border border-[#f1aa4e]/70 bg-[#f1aa4e] px-6 py-3 text-sm font-bold text-[#151008] shadow-lg shadow-[#f1aa4e]/20 transition hover:-translate-y-0.5 hover:bg-[#ffd18a]"
                    >
                        Ver ranking
                    </a>
                    <a
                        href="/"
                        class="rounded-full border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-[#f6f1e8] transition hover:-translate-y-0.5 hover:bg-white/10"
                    >
                        Volver al portfolio
                    </a>
                </div>
                <div class="mt-16 grid gap-4 sm:grid-cols-3">
                    <article
                        class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur"
                    >
                        <p
                            class="text-sm uppercase tracking-[0.25em] text-[#a8b2d1]"
                        >
                            Modo
                        </p>
                        <p class="mt-3 text-2xl font-bold">Ranking vivo</p>
                    </article>
                    <article
                        class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur"
                    >
                        <p
                            class="text-sm uppercase tracking-[0.25em] text-[#a8b2d1]"
                        >
                            Origen
                        </p>
                        <p class="mt-3 text-2xl font-bold">Partidas reales</p>
                    </article>
                    <article
                        class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur"
                    >
                        <p
                            class="text-sm uppercase tracking-[0.25em] text-[#a8b2d1]"
                        >
                            Estilo
                        </p>
                        <p class="mt-3 text-2xl font-bold">{accent}</p>
                    </article>
                </div>
            </section>
        </main>
    </body>
</html>
