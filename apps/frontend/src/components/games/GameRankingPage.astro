---
import GamesLayout from "../games/GamesLayout.astro";
interface Props {
    gameName: string;
    gameSlug: string;
    subtitle: string;
    accentLabel: string;
}

const { gameName, gameSlug, subtitle, accentLabel } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000";
---

<GamesLayout title={`${gameName} Ranking | rubennmg`}>
        <main id="game-content" class="games-main shell">

            <section class="mx-auto max-w-7xl">
                <nav
                    class="mb-10 flex items-center justify-between gap-4 text-sm text-textsoft"
                >
                    <a
                        href="/games"
                        class="transition hover:text-df-text">← Todos los juegos</a
                    >
                    <a href="/" class="transition hover:text-df-text">Portfolio</a
                    >
                </nav>

                <header
                    class="grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-end"
                >
                    <div>
                        <p
                            class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-accent"
                        >
                            {accentLabel}
                        </p>
                        <h1
                            class="text-4xl font-extrabold tracking-tight text-df-text sm:text-6xl"
                        >
                            Ranking de {gameName}
                        </h1>
                        <p
                            class="mt-5 max-w-2xl text-lg leading-8 text-textsoft"
                        >
                            {subtitle}
                        </p>
                    </div>
                    <div
                        class="soft-card p-6"
                    >
                        <p
                            class="text-sm uppercase tracking-[0.2em] text-textsoft"
                        >
                            Actualización
                        </p>
                        <p class="mt-3 text-2xl font-bold text-df-text">
                            Desde partidas registradas
                        </p>
                        <p class="mt-2 text-sm text-textsoft">
                            Los rankings no se editan manualmente.
                        </p>
                    </div>
                </header>

                <section
                    id="loading-state"
                    class="mt-12 rounded-3xl border border-border bg-background p-8 text-textsoft"
                >
                    Cargando ranking...
                </section>

                <section
                    id="error-state"
                    class="mt-12 hidden rounded-3xl border border-[var(--feedback-error)]/30 bg-[var(--feedback-error)]/10 p-8 text-[var(--feedback-error)]"
                >
                    No se pudo cargar el ranking. Inténtalo de nuevo más tarde.
                </section>

                <section
                    id="empty-state"
                    class="mt-12 hidden rounded-3xl border border-border bg-background p-8 text-textsoft"
                >
                    Todavía no hay jugadores disponibles para este ranking.
                </section>

                <section id="ranking-content" class="mt-12 hidden">
                    <div class="grid gap-4 md:grid-cols-3">
                        <article
                            class="rounded-3xl border border-border bg-background p-6"
                        >
                            <p
                                class="text-sm uppercase tracking-[0.2em] text-textsoft"
                            >
                                Jugadores
                            </p>
                            <p
                                id="total-players"
                                class="mt-3 text-4xl font-extrabold text-df-text"
                            >
                                0
                            </p>
                        </article>
                        <article
                            class="rounded-3xl border border-border bg-background p-6"
                        >
                            <p
                                class="text-sm uppercase tracking-[0.2em] text-textsoft"
                            >
                                Partidas
                            </p>
                            <p
                                id="total-matches"
                                class="mt-3 text-4xl font-extrabold text-df-text"
                            >
                                0
                            </p>
                        </article>
                        <article
                            class="rounded-3xl border border-border bg-background p-6"
                        >
                            <p
                                class="text-sm uppercase tracking-[0.2em] text-textsoft"
                            >
                                Líder
                            </p>
                            <p
                                id="ranking-leader"
                                class="mt-3 text-4xl font-extrabold text-df-text"
                            >
                                -
                            </p>
                        </article>
                    </div>

                    <div
                        id="podium"
                        class="mt-8 grid gap-4 md:grid-cols-3 md:items-end"
                    >
                    </div>

                    <div
                        class="mt-8 overflow-hidden rounded-3xl border border-border bg-background"
                    >
                        <p class="border-b border-border px-5 py-4 text-sm text-textsoft">
                            Pulsa una fila para abrir la ficha del jugador en {gameName}.
                        </p>
                        <div class="overflow-x-auto">
                            <table
                                class="min-w-full divide-y divide-border text-left text-sm"
                            >
                                <thead
                                    class="bg-background text-xs uppercase tracking-[0.18em] text-textsoft"
                                >
                                    <tr>
                                        <th class="px-5 py-4">#</th>
                                        <th class="px-5 py-4">Jugador</th>
                                        <th class="px-5 py-4">Partidas</th>
                                        <th class="px-5 py-4">Victorias</th>
                                        <th class="px-5 py-4">Puntos</th>
                                        <th class="px-5 py-4">Media</th>
                                        <th class="px-5 py-4">Win rate</th>
                                    </tr>
                                </thead>
                                <tbody
                                    id="ranking-table"
                                    class="divide-y divide-border text-df-text"
                                ></tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </section>
        </main>

        <script is:inline define:vars={{ apiUrl, gameSlug }}>
            const loadingState = document.getElementById("loading-state");
            const errorState = document.getElementById("error-state");
            const emptyState = document.getElementById("empty-state");
            const rankingContent = document.getElementById("ranking-content");
            const podium = document.getElementById("podium");
            const table = document.getElementById("ranking-table");

            const formatNumber = (value) =>
                new Intl.NumberFormat("es-ES", {
                    maximumFractionDigits: 2,
                }).format(value);

            const show = (element) => element?.classList.remove("hidden");
            const hide = (element) => element?.classList.add("hidden");

            const playerUrl = (row) => `/games/${gameSlug}/player?id=${encodeURIComponent(row.player_id)}`;

            const podiumCard = (row, index) => {
                const heights = [
                    "md:min-h-[15rem]",
                    "md:min-h-[12rem]",
                    "md:min-h-[10rem]",
                ];
                const medals = ["🥇", "🥈", "🥉"];
                const card = document.createElement("article");
                card.className = `${heights[index]} soft-card p-6`;
                card.innerHTML = `
                        <div class="text-3xl">${medals[index]}</div>
                        <p class="mt-4 text-sm uppercase tracking-[0.2em] text-textsoft">Puesto ${row.position}</p>
                        <h2 class="mt-2 text-3xl font-extrabold text-df-text"></h2>
                        <div class="mt-5 grid grid-cols-2 gap-3 text-sm text-textsoft">
                            <span>${row.wins} victorias</span>
                            <span>${formatNumber(row.win_rate)}%</span>
                            <span>${row.total_points} pts</span>
                            <span>${formatNumber(row.average_points)} media</span>
                        </div>
                `;
                const playerLink = document.createElement("a");
                playerLink.href = playerUrl(row);
                playerLink.className = "fine-link";
                playerLink.textContent = row.player_name;
                card.querySelector("h2").append(playerLink);
                return card;
            };

            const tableRow = (row) => {
                const tr = document.createElement("tr");
                tr.className = "cursor-pointer transition hover:bg-accent-soft/40 focus-within:bg-accent-soft/40";
                tr.innerHTML = `
                    <td class="px-5 py-4 font-bold text-accent">${row.position}</td>
                    <td class="px-5 py-4 font-semibold text-df-text"></td>
                    <td class="px-5 py-4">${row.matches_played}</td>
                    <td class="px-5 py-4">${row.wins}</td>
                    <td class="px-5 py-4">${row.total_points}</td>
                    <td class="px-5 py-4">${formatNumber(row.average_points)}</td>
                    <td class="px-5 py-4">${formatNumber(row.win_rate)}%</td>
            `;
                const playerLink = document.createElement("a");
                playerLink.href = playerUrl(row);
                playerLink.className = "fine-link text-left text-accent";
                playerLink.textContent = row.player_name;
                playerLink.setAttribute("aria-label", `Ver estadísticas de ${row.player_name}`);
                tr.children[1].append(playerLink);
                tr.addEventListener("click", (event) => {
                    if (event.target.closest("a") || window.getSelection()?.toString()) return;
                    if (event.ctrlKey || event.metaKey) {
                        window.open(playerLink.href, "_blank", "noopener");
                    } else {
                        window.location.assign(playerLink.href);
                    }
                });
                return tr;
            };

            async function loadRanking() {
                try {
                    const response = await fetch(
                        `${apiUrl}/api/games/${gameSlug}/rankings`,
                        {
                            headers: { Accept: "application/json" },
                        },
                    );
                    if (!response.ok) throw new Error("Ranking request failed");

                    const data = await response.json();
                    hide(loadingState);

                    if (!data.ranking.length) {
                        show(emptyState);
                        return;
                    }

                    document.getElementById("total-players").textContent =
                        String(data.summary.total_players);
                    document.getElementById("total-matches").textContent =
                        String(data.summary.total_matches);
                    const participants = data.ranking.filter((row) => row.matches_played > 0);
                    document.getElementById("ranking-leader").textContent =
                        participants[0]?.player_name ?? "Sin partidas";
                    podium.replaceChildren(
                        ...participants.slice(0, 3).map(podiumCard),
                    );
                    table.replaceChildren(...data.ranking.map(tableRow));
                    show(rankingContent);
                } catch (error) {
                    hide(loadingState);
                    show(errorState);
                }
            }

            loadRanking();
        </script>
</GamesLayout>
