---
const { title, place, description, date, link, current, currentLabel } =
    Astro.props;
---

<article class="soft-card flex min-h-64 flex-col p-6 sm:p-7">
    <div class="flex items-start justify-between gap-3">
        <time
            class="text-xs font-bold uppercase tracking-[0.14em] text-textsoft"
            >{date}</time
        >{
            current && (
                <span class="rounded-full bg-accent-soft px-2.5 py-1 text-[0.68rem] font-bold text-accent">
                    {currentLabel}
                </span>
            )
        }
    </div>
    <h3
        class="mt-8 text-xl font-extrabold leading-tight tracking-tight text-df-text"
    >
        {title}
    </h3><a
        class="fine-link mt-2 w-fit font-semibold text-textsoft hover:text-df-text"
        href={link}
        target="_blank"
        rel="noopener noreferrer">{place} <span aria-hidden="true">↗</span></a
    ><p class="mt-4 text-sm leading-6 text-textsoft">{description}</p>
</article>
