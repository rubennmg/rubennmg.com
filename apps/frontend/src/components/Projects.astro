---
import ProjectItem from "./ProjectItem.astro";
const { items, codeLabel, carouselLabels } = Astro.props;
---

<div class="grid gap-4 lg:grid-cols-2">
    {
        items.map((project, index) => (
            <ProjectItem
                {...project}
                codeLabel={codeLabel}
                carouselLabels={carouselLabels}
                featured={index < 2}
            />
        ))
    }
</div>
