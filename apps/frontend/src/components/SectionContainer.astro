---
interface Props {
    id: string;
    eyebrow?: string;
    title?: string;
    description?: string;
    class?: string;
}

const { class: className = "", description, eyebrow, id, title } = Astro.props;
---

<section
    id={id}
    class={`content-section reveal scroll-mt-24 py-14 sm:py-20 ${className}`}
>
    <div class="section-inner shell">
        {
            title && (
                <header class="section-heading mb-9 grid gap-4 pt-7 lg:grid-cols-[0.34fr_1fr] lg:gap-10 lg:pt-9">
                    {eyebrow && (
                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent">
                            {eyebrow}
                        </p>
                    )}
                    <div>
                        <h2 class="text-3xl font-extrabold tracking-[-0.035em] text-df-text sm:text-4xl lg:text-5xl">
                            {title}
                        </h2>
                        {description && (
                            <p class="mt-4 max-w-3xl text-base leading-7 text-textsoft sm:text-lg">
                                {description}
                            </p>
                        )}
                    </div>
                </header>
            )
        }
        <slot />
    </div>
</section>
