---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import SectionContainer from "./SectionContainer.astro";
import Education from "./Education.astro";
import Projects from "./Projects.astro";
import Experience from "./Experience.astro";
import LinkButton from "./LinkButton.astro";
import SocialPill from "./SocialPill.astro";
import "../styles/global.css";

const { content } = Astro.props;
const homeId = content.locale === "es" ? "inicio" : "home";
const experienceHref = `#${content.sections.experience.id}`;
const canonicalPath = content.locale === "es" ? "/" : "/en/";
---

<html lang={content.locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={content.meta.description} />
        <meta name="theme-color" content="#f3f1eb" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={`https://rubennmg.com${canonicalPath}`} />
        <link rel="alternate" hreflang="es" href="https://rubennmg.com/" />
        <link rel="alternate" hreflang="en" href="https://rubennmg.com/en/" />
        <link
            rel="alternate"
            hreflang="x-default"
            href="https://rubennmg.com/"
        />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={content.meta.title} />
        <meta property="og:description" content={content.meta.description} />
        <meta
            property="og:url"
            content={`https://rubennmg.com${canonicalPath}`}
        />
        <meta property="og:image" content="https://rubennmg.com/og.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Rubén Martínez Ginzo · Ingeniero informático · Software developer"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={content.meta.title} />
        <meta name="twitter:description" content={content.meta.description} />
        <meta name="twitter:image" content="https://rubennmg.com/og.png" />
        <title>{content.meta.title}</title>
        <script is:inline>
            (() => {
                document.documentElement.classList.add("has-js");
                const stored = localStorage.getItem("theme");
                const dark = stored
                    ? stored === "dark"
                    : matchMedia("(prefers-color-scheme: dark)").matches;
                document.documentElement.dataset.theme = dark
                    ? "dark"
                    : "light";
            })();
        </script>
    </head>
    <body class="bg-bodyback text-df-text antialiased">
        <a class="skip-link" href={`#${homeId}`}>{content.labels.skip}</a>
        <Header content={content} />
        <div class="scroll-progress" aria-hidden="true">
            <span id="scroll-progress-bar" class="scroll-progress__bar"></span>
            <div class="scroll-progress__markers">
                {
                    Object.values(content.sections).map((section, index, sections) => (
                        <span
                            class="scroll-progress__marker"
                            data-section-id={section.id}
                            style={`--marker-position: ${(index / (sections.length - 1)) * 100}%`}
                        >
                            {String(index + 1).padStart(2, "0")}
                        </span>
                    ))
                }
            </div>
        </div>
        <main id={homeId}>
            <section class="hero shell">
                <div class="reveal max-w-4xl">
                    <h1 class="hero-title">{content.profile.intro}</h1>
                    <p
                        class="mt-7 text-lg font-semibold text-df-text sm:text-xl"
                    >
                        {content.profile.name}
                    </p>
                    <p
                        class="mt-1 text-sm font-medium uppercase tracking-[0.12em] text-textsoft"
                    >
                        {content.profile.role}
                    </p>
                    <p class="mt-7 max-w-2xl text-lg leading-8 text-textsoft">
                        {content.profile.summary}
                    </p>
                    <div class="mt-9 flex flex-wrap gap-3">
                        <LinkButton href={experienceHref} target="_self"
                            >{content.hero.primaryAction}
                            <span aria-hidden="true">↓</span></LinkButton
                        >
                        <SocialPill href={content.socials[1].href}
                            >{content.hero.secondaryAction}
                            <span aria-hidden="true">↗</span></SocialPill
                        >
                    </div>
                </div>
                <aside class="reveal reveal-delay-2 status-card">
                    <img
                        src="/me.png"
                        alt={content.profile.name}
                        class="profile-portrait"
                        width="433"
                        height="433"
                    />
                    <p class="eyebrow">{content.hero.status}</p>
                    <p class="mt-5 text-xl font-extrabold leading-snug tracking-tight text-df-text sm:text-2xl">
                        {content.hero.statement}
                    </p>
                    <div
                        class="mt-8 flex items-center gap-3 border-t border-border pt-5 text-sm text-textsoft"
                    >
                        <span class="size-2 rounded-full bg-accent"></span>{
                            content.profile.location
                        }
                    </div>
                </aside>
                <div class="reveal reveal-delay-3 stats-strip">
                    {
                        content.highlights.map((highlight) => (
                            <div>
                                <>
                                    <p class="text-lg font-extrabold text-df-text sm:text-xl">
                                        {highlight.value}
                                    </p>
                                    <p class="mt-1 text-sm text-textsoft">
                                        {highlight.label}
                                    </p>
                                </>
                            </div>
                        ))
                    }
                </div>
            </section>

            <SectionContainer {...content.sections.experience} class="section-experience"
                ><Experience
                    items={content.experience}
                    currentLabel={content.labels.current}
                /></SectionContainer
            >
            <SectionContainer {...content.sections.education} class="section-education"
                ><Education
                    items={content.education}
                    currentLabel={content.labels.current}
                /></SectionContainer
            >
            <SectionContainer {...content.sections.projects} class="section-projects"
                ><Projects
                    items={content.projects}
                    codeLabel={content.labels.code}
                    carouselLabels={content.labels.carousel}
                /></SectionContainer
            >
            <SectionContainer {...content.sections.contact} class="section-contact pb-8">
                <div class="contact-panel">
                    <div class="flex flex-wrap gap-2">
                        {
                            content.skills.map((skill) => (
                                <span class="tag">{skill}</span>
                            ))
                        }
                    </div>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <LinkButton
                            href={`mailto:${content.profile.email}`}
                            target="_self">{content.labels.email}</LinkButton
                        >
                        {
                            content.socials.map((social) => (
                                <SocialPill href={social.href}>
                                    {social.label}{" "}
                                    <span aria-hidden="true">↗</span>
                                </SocialPill>
                            ))
                        }
                    </div>
                </div>
            </SectionContainer>
        </main>
        <Footer content={content} />
        <script>
            const button = document.querySelector("#theme-toggle");
            button?.addEventListener("click", () => {
                const next =
                    document.documentElement.dataset.theme === "dark"
                        ? "light"
                        : "dark";
                document.documentElement.dataset.theme = next;
                localStorage.setItem("theme", next);
            });

            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            const revealElements = document.querySelectorAll(".reveal");

            if (reducedMotion || !("IntersectionObserver" in window)) {
                revealElements.forEach((element) =>
                    element.classList.add("is-visible"),
                );
            } else {
                const revealObserver = new IntersectionObserver(
                    (entries, observer) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;
                            entry.target.classList.add("is-visible");
                            observer.unobserve(entry.target);
                        });
                    },
                    { threshold: 0.12, rootMargin: "0px 0px -8%" },
                );
                revealElements.forEach((element) =>
                    revealObserver.observe(element),
                );
            }

            const progressBar = document.querySelector<HTMLElement>(
                "#scroll-progress-bar",
            );
            const contentSections = Array.from(
                document.querySelectorAll<HTMLElement>(".content-section"),
            );
            const progressMarkers = Array.from(
                document.querySelectorAll<HTMLElement>(
                    ".scroll-progress__marker",
                ),
            );
            let progressFrame = 0;
            const updateScrollProgress = () => {
                const scrollable =
                    document.documentElement.scrollHeight - window.innerHeight;
                const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
                progressBar?.style.setProperty(
                    "--scroll-progress",
                    String(Math.min(1, Math.max(0, progress))),
                );
                const readingLine = window.innerHeight * 0.48;
                let activeSection = contentSections[0]?.id;
                contentSections.forEach((section) => {
                    if (section.getBoundingClientRect().top <= readingLine) {
                        activeSection = section.id;
                    }
                });
                progressMarkers.forEach((marker) => {
                    marker.classList.toggle(
                        "is-active",
                        marker.dataset.sectionId === activeSection,
                    );
                });
                progressFrame = 0;
            };
            const requestProgressUpdate = () => {
                if (progressFrame) return;
                progressFrame = window.requestAnimationFrame(updateScrollProgress);
            };
            updateScrollProgress();
            window.addEventListener("scroll", requestProgressUpdate, {
                passive: true,
            });
            window.addEventListener("resize", requestProgressUpdate);
        </script>
    </body>
</html>
